        "layer_size": 128,
        "latent_dim": 64,
        "batch_size": 64,
        "dropout_rate": 0.18,
        "learning_rate": 0.0008,
        "noise_level_sigma": 0.14,
        "sparsity_weight_lambda_s": 0.0045,
        "variance_threshold_epsilon_split": 8e-06,
        "merge_threshold_epsilon_merge": 0.009,
        "cluster_reg_weight_lambda_c": 0.28,
        "memory_reg_weight_alpha": 0.19,
        "context_window_size": 7
